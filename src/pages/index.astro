---
import { getCollection } from 'astro:content';
import { CONTACT_COLLECTION, SITE_SLUG, TURNSTILE_SITE_KEY, UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../site-config';
import { url } from '../lib/base';

const byOrder = (a: any, b: any) => (a.data.order ?? 0) - (b.data.order ?? 0);
const services = (await getCollection('services')).sort(byOrder);
const gallery = (await getCollection('gallery')).sort(byOrder);
const reviews = (await getCollection('reviews')).sort(byOrder);

// Bump on every publish so browsers don't keep an old stylesheet or script.
const v = '8';
const PHONE = '(717) 286-3170';
const TEL = 'tel:+17172863170';
const SMS = 'sms:+17172863170';
const EMAIL = 'markdpawling@gmail.com';
const FACEBOOK = 'https://www.facebook.com/people/Pawling-masonry-inc/100064440384288/';
// Mark's Google Business Profile, by its permanent CID rather than the
// share.google short link it came from — a redirector is one retirement away
// from being a dead link, and this one is the listing's own id.
const GOOGLE_PROFILE = 'https://maps.google.com/?cid=12162634381602271849';
const sizeClass: Record<string, string> = { narrow: 'half', wide: 'wide' };
// Where this Site's forms post. `PUBLIC_SCRIBE_API_URL` is an **organisation**
// variable on the GitHub org that owns this repo, passed to the build by
// `deploy.yml`, and it has **no default in a production build** (RFC 0025).
//
// It used to fall back to the production admin, which is the failure that rule
// exists to end: a `PUBLIC_*` value is inlined into the client bundle at build
// time, so a Site that guessed shipped the wrong endpoint and posted a Visitor's
// message to whichever Scribe the fallback named — noticed, if ever, by a Client
// wondering why nobody replied. Failing the build is the cheap version of that.
//
// GitHub resolves an unset `vars.*` to an empty string rather than leaving it
// undefined, so empty has to count as missing. Dev falls back to a *local*
// admin, never production, so `npm run dev` needs no env file and still cannot
// write to a real Client's database by omission.
function scribeApiBase(): string {
  const configured = import.meta.env.PUBLIC_SCRIBE_API_URL?.trim();
  if (configured) return configured;
  if (import.meta.env.PROD) {
    throw new Error(
      'PUBLIC_SCRIBE_API_URL is unset. Set it as an organisation variable on the GitHub org that owns ' +
        'this repo — it has no default in a production build, so this Site posts nowhere by accident.',
    );
  }
  return 'http://localhost:3040';
}

const SCRIBE_API = scribeApiBase();

// Mark's Google Business Profile address. It must match the profile exactly —
// a business whose site and listing disagree about where it is ranks worse
// than one that names no address at all.
const ADDRESS = { street: '3688 Emory Church Rd', city: 'Street', state: 'MD', zip: '21154' };

// Astro.url.pathname carries the base path; Astro.site is the live domain,
// where the Site is served from the root. Strip the base so the two never
// compose into a canonical URL that does not exist.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const path =
  (basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length)
    : Astro.url.pathname) || '/';
const canonical = new URL(path, Astro.site);
const cardImage = new URL('/og-card.jpg', Astro.site);

const OG_TITLE = 'Pawling Masonry Inc \u2014 Masonry and concrete in northern Maryland and southern PA';
const OG_DESCRIPTION = `Stone, brick and block work, concrete walks, steps and patios, and chimney repair. Licensed in PA, free estimates. Call or text Mark at ${PHONE}.`;

// What a search engine reads to decide this is a real business in a real
// place, rather than a page about one. The reviews on this page are
// deliberately *not* marked up: Google reserves review markup for a site
// reviewing other businesses, and self-serving review markup is what gets a
// site penalised.
const business = {
  '@context': 'https://schema.org',
  // Both, rather than just `GeneralContractor`. The specific type is what
  // tells Google what trade this is; `LocalBusiness` is its parent and is
  // what `scribe site seo` matches on, which today is an exact match against
  // two names rather than the subtype tree.
  '@type': ['GeneralContractor', 'LocalBusiness'],
  name: 'Pawling Masonry Inc',
  description: 'Stone, brick and block work, concrete walks, steps and patios, and chimney repair and rebuilds.',
  url: 'https://pawlingmasonry.com',
  telephone: TEL.replace('tel:', ''),
  email: EMAIL,
  image: cardImage.href,
  logo: new URL('/images/pawlingmasonry.logo-dark.svg', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ADDRESS.street,
    addressLocality: ADDRESS.city,
    addressRegion: ADDRESS.state,
    postalCode: ADDRESS.zip,
    addressCountry: 'US',
  },
  // The yard is in Harford County, MD; the phone is a 717 number and the page
  // says "Licensed in PA". Both sides of the line, then, rather than one.
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Harford County, MD' },
    { '@type': 'AdministrativeArea', name: 'Southern Pennsylvania' },
  ],
  // The Google Business Profile first: it is what ties this domain to the
  // listing holding the reviews, hours and address, rather than leaving
  // Google to infer the link from a matching name and phone number.
  sameAs: [GOOGLE_PROFILE, FACEBOOK],
  geo: { '@type': 'GeoCoordinates', latitude: 39.663785, longitude: -76.363741 },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pawling Masonry Inc | Masonry and Concrete</title>
  <meta name="description" content={OG_DESCRIPTION}>
  <link rel="canonical" href={canonical}>

  <meta property="og:site_name" content="Pawling Masonry Inc">
  <meta property="og:type" content="website">
  <meta property="og:title" content={OG_TITLE}>
  <meta property="og:description" content={OG_DESCRIPTION}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={cardImage}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={OG_TITLE}>
  <meta name="twitter:description" content={OG_DESCRIPTION}>
  <meta name="twitter:image" content={cardImage}>

  <script type="application/ld+json" set:html={JSON.stringify(business)} is:inline />
  <link rel="icon" type="image/png" href={url('/images/pawlingmasonry.icon.png')}>
  <link rel="apple-touch-icon" href={url('/images/pawlingmasonry.icon.png')}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={url(`/css/style.css?v=${v}`)}>
  {UMAMI_WEBSITE_ID && UMAMI_SCRIPT_URL && (
    <script defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID}></script>
  )}
</head>
<body>

  <header class="site-header">
    <div class="wrap header-row">
      <a href="#top" class="brand"><img src={url('/images/pawlingmasonry.logo-horizontal-dark.svg')} alt="Pawling Masonry Inc" width="758" height="191"></a>
      <nav class="nav" aria-label="Main">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#reviews">Reviews</a>
        <a href="#estimate">Estimate</a>
      </nav>
      <a class="btn btn-brick header-call" href={TEL}>Call or text <span>{PHONE}</span></a>
    </div>
  </header>

  <main id="top">

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Licensed in PA &middot; Free estimates</p>
        <h1>Masonry &amp; Concrete</h1>
        <p class="lede">Stone, brick and block work. Concrete walks, steps and patios. Chimney repair and rebuilds. Call or text Mark for a free estimate.</p>
        <div class="hero-actions">
          <a class="btn btn-brick" href={TEL}>Call or text {PHONE}</a>
          <a class="btn btn-line" href="#estimate">Get a free estimate</a>
        </div>
        <p class="rating"><span class="stars" aria-hidden="true">★★★★★</span> 5.0 on Google</p>
      </div>
      <figure class="hero-photo">
        <img src={url('/uploads/brick-fireplace-arch.jpg')} alt="A brick outdoor fireplace with an arched opening, built by Pawling Masonry" width="1050" height="1400">
        <figcaption>Brick outdoor fireplace</figcaption>
      </figure>
    </section>

    <section id="services" class="services">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Services</p>
          <h2>What we do</h2>
        </div>
        <ol class="service-list">
          {services.map((s, i) => (
            <li class="service">
              <div class="service-photo"><img src={url(s.data.photo)} alt={s.data.photoAlt ?? ''} loading="lazy"></div>
              <div class="service-body">
                <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.data.title}</h3>
                <p>{s.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="rebuild">
      <div class="wrap rebuild-grid">
        <div class="rebuild-copy">
          <p class="eyebrow">Before &amp; after</p>
          <h2>Chimney tear-down and rebuild</h2>
          <p>Before: a bare metal flue pipe. After: a red-brick chimney with an arched top.</p>
        </div>
        <figure class="ba">
          <img src={url('/uploads/chimney-before.jpg')} alt="Before: a bare metal flue pipe on the roof" loading="lazy">
          <figcaption>Before</figcaption>
        </figure>
        <figure class="ba">
          <img src={url('/uploads/chimney-after.jpg')} alt="After: a new red-brick chimney with an arched top on the same house" loading="lazy">
          <figcaption>After</figcaption>
        </figure>
      </div>
    </section>

    <section id="work" class="work">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Recent jobs</p>
          <h2>Our work</h2>
        </div>
        <div class="bond">
          {gallery.map((g) => (
            <figure class={`brick ${sizeClass[g.data.size ?? 'normal'] ?? ''}`.trim()}>
              <img src={url(g.data.photo)} alt={g.data.photoAlt ?? ''} loading="lazy">
              <figcaption>{g.data.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="reviews" class="reviews">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Reviews</p>
          <h2><a class="reviews-link" href={GOOGLE_PROFILE} rel="noopener">5.0 stars on Google</a></h2>
          <p class="reviews-more"><a href={GOOGLE_PROFILE} rel="noopener">Read them all on Google &rarr;</a></p>
        </div>
        <div class="quotes">
          {reviews.map((r) => (
            <blockquote>
              <p>&ldquo;{r.data.quote}&rdquo;</p>
              <cite>{r.data.name}{r.data.job && <> &middot; {r.data.job}</>}</cite>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section id="estimate" class="estimate">
      <div class="wrap estimate-grid">
        <div class="estimate-copy">
          <p class="eyebrow">Free estimates</p>
          <h2>Text Mark a photo of the job</h2>
          <p>Fastest way to a free estimate: text a picture of what needs work. Or fill out the form.</p>
          <a class="phone-big" href={TEL}>{PHONE}</a>
          <p class="contact-line"><a href={SMS}>Send a text</a> &middot; <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        </div>

        <form class="estimate-form" id="estimate-form" novalidate data-site={SITE_SLUG} data-collection={CONTACT_COLLECTION} data-endpoint={`${SCRIBE_API}/api/submissions`} data-scribe-retry>
          <label>Name
            <input name="name" type="text" autocomplete="name">
          </label>
          <label>Phone or email
            <input name="contact" type="text" autocomplete="tel">
          </label>
          <label>Type of work
            <select name="kind">
              {services.map((s) => <option>{s.data.title}</option>)}
              <option>Something else</option>
            </select>
          </label>
          <label>About the job
            <textarea name="message" rows="4"></textarea>
          </label>
          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
          <button class="btn btn-brick" type="submit">Send to Mark</button>
          <p class="form-status" id="form-status" role="status"></p>
        </form>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <img class="footer-logo" src={url('/images/pawlingmasonry.logo-dark.svg')} alt="Pawling Masonry Inc" width="540" height="456" loading="lazy">
      <div class="footer-info">
        <p><a href={TEL}>{PHONE}</a> &middot; call or text</p>
        <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        <p><a href={FACEBOOK} rel="noopener">Facebook</a></p>
        <p class="address">{ADDRESS.street}<br>{ADDRESS.city}, {ADDRESS.state} {ADDRESS.zip}</p>
        <p class="small">&copy; 2026 Pawling Masonry Inc</p>
      </div>
    </div>
  </footer>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline src={url(`/js/main.js?v=${v}`)}></script>
</body>
</html>
